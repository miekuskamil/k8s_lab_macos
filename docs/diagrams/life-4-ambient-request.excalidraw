   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each HBONE tunnel is a two-way stream: the response returns through the same tunnels and identities. Then conntrack undoes the SNAT and the DNAT, nginx and Docker pass the bytes on, and curl prints",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "Each HBONE tunnel is a two-way stream: the response returns through the same tunnels and identities. Then conntrack undoes the SNAT and the DNAT, nginx and Docker pass the bytes on, and curl prints",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "x97",
   "type": "text",
