   "versionNonce": 2097,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the JSON. Nothing decides anything on the way back: every check happened on the way in.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
