   "versionNonce": 2112,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each watcher writes its result back through gates 1 to 6, like kubectl, with its own identity and RBAC role. The next watcher notices the new object. Two writers racing on one object: the second gets",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "Each watcher writes its result back through gates 1 to 6, like kubectl, with its own identity and RBAC role. The next watcher notices the new object. Two writers racing on one object: the second gets",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "x113",
   "type": "text",
   "x": 52,
   "y": 1504,
   "width": 785,
   "height": 17,
   "angle": 0,
   "strokeColor": "#57606a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1113,
   "version": 1,
   "versionNonce": 2113,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "409 Conflict, because its resourceVersion is stale, re-reads and tries again (optimistic concurrency).",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "409 Conflict, because its resourceVersion is stale, re-reads and tries again (optimistic concurrency).",
