  {
   "id": "x112",
   "type": "text",
   "x": 52,
   "y": 1485,
   "width": 1532,
   "height": 17,
   "angle": 0,
   "strokeColor": "#57606a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
