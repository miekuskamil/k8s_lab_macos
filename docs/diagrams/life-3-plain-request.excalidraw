   "versionNonce": 2040,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "No encryption: anyone who captures packets on the node reads the request.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "No encryption: anyone who captures packets on the node reads the request.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
