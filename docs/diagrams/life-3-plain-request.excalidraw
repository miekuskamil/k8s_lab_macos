   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "No policy: any pod in the cluster connects, unless a NetworkPolicy says otherwise.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "No policy: any pod in the cluster connects, unless a NetworkPolicy says otherwise.",
   "lineHeight": 1.25,
   "autoResize": true
  },
