   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "No identity: nginx knows an IP, and IPs change with every pod.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "No identity: nginx knows an IP, and IPs change with every pod.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
