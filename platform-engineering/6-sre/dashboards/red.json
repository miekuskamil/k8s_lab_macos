{
  "uid": "sre-red",
  "title": "SRE / RED",
  "description": "Rate, errors and duration for any app that serves http_request_duration_seconds.",
  "tags": [
    "sre",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_request_duration_seconds_count, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(http_request_duration_seconds_count, namespace)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_request_duration_seconds_count{namespace=\"$namespace\"}, app)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(http_request_duration_seconds_count{namespace=\"$namespace\"}, app)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "USE",
      "type": "link",
      "url": "/d/sre-use/sre-use?var-namespace=${namespace}",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate: requests per second",
      "description": "R of RED: how much work arrives.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app) (rate(http_request_duration_seconds_count{namespace=\"$namespace\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "links": [
            {
              "title": "USE: pods of ${__field.labels.app}",
              "url": "/d/sre-use/sre-use?var-namespace=${namespace}&var-pod=${__field.labels.app}-.*"
            }
          ],
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors: share of 5xx",
      "description": "E of RED: how much of that work fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (app) (rate(http_request_duration_seconds_count{namespace=\"$namespace\", app=~\"$app\", status=~\"5..\"}[$__rate_interval])) or sum by (app) (rate(http_request_duration_seconds_count{namespace=\"$namespace\", app=~\"$app\"}[$__rate_interval])) * 0) / sum by (app) (rate(http_request_duration_seconds_count{namespace=\"$namespace\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "links": [
            {
              "title": "USE: pods of ${__field.labels.app}",
              "url": "/d/sre-use/sre-use?var-namespace=${namespace}&var-pod=${__field.labels.app}-.*"
            }
          ],
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration: p95",
      "description": "D of RED: how long the work takes, for 95% of requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (app, le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", app=~\"$app\"}[$__rate_interval])))",
          "legendFormat": "{{app}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "links": [
            {
              "title": "USE: pods of ${__field.labels.app}",
              "url": "/d/sre-use/sre-use?var-namespace=${namespace}&var-pod=${__field.labels.app}-.*"
            }
          ],
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app, status) (rate(http_request_duration_seconds_count{namespace=\"$namespace\", app=~\"$app\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Duration: p50, p95, p99",
      "description": "Percentiles come from buckets, so they are estimates between bucket edges.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (app, le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", app=~\"$app\"}[$__rate_interval])))",
          "legendFormat": "p50 {{app}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (app, le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", app=~\"$app\"}[$__rate_interval])))",
          "legendFormat": "p95 {{app}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (app, le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", app=~\"$app\"}[$__rate_interval])))",
          "legendFormat": "p99 {{app}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
